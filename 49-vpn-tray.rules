// VPN Tray: start/stop/restart usług VPN (twingate.service, netbird.service, netbird@<iface>.service)
// bez hasła dla użytkowników z grupy wheel w aktywnej, lokalnej sesji - odpowiednik operatora Tailscale.
// Włączanie autostartu (enable/disable) nadal pyta o hasło. Tailscale (LocalAPI + operator)
// i WireGuard (NetworkManager) tej reguły nie potrzebują.
polkit.addRule(function(action, subject) {
    var unit = action.lookup("unit") || "";
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        /^(twingate|netbird(@[A-Za-z0-9_-]+)?)\.service$/.test(unit) &&
        ["start", "stop", "restart"].indexOf(action.lookup("verb")) >= 0 &&
        subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
